{
  "compilerOptions": {
    "target": "ES2020"
  , "module": "NodeNext"
  , "moduleResolution": "NodeNext"
  , "strict": true
  , "esModuleInterop": true
  , "noUnusedLocals": true
  , "noUnusedParameters": true
  , "rootDir": "src"
  , "paths": {
      "@utils/*": ["./src/utils/*"]
    , "@functions/*": ["./src/functions/*"]
    , "@classes/*": ["./src/classes/*"]
    , "@src/*": ["./src/*"]
    , "@test/*": ["./__tests__/*"]
    }
  }
}
